# Full backend base URL (no trailing slash, no /api/v1 — that's appended in code).
# Set this to point at a deployed backend, e.g. production:
# API_URL=https://skill-app-backend-production.up.railway.app
API_URL=

# Used only when API_URL is blank, for local dev against a backend running on
# this machine. Leave API_HOST blank to auto-detect (10.0.2.2 on the Android
# emulator, localhost on iOS simulator); set it to your LAN IP for a physical device.
API_PROTOCOL=http
API_PORT=8000
API_HOST=
